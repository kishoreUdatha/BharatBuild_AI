# Application
APP_NAME=BharatBuild AI
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
API_VERSION=v1

# Database
DATABASE_URL=postgresql://bharatbuild:bharatbuild123@localhost:5432/bharatbuild_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1

# Celery
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# Claude AI
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_HAIKU_MODEL=claude-haiku-4-5
CLAUDE_SONNET_MODEL=claude-sonnet-5
CLAUDE_OPUS_MODEL=claude-opus-5
CLAUDE_DEFAULT_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# Storage: MinIO (Local S3-compatible storage)
# Architecture: Sandbox (runtime) → S3/MinIO (file content) → PostgreSQL (metadata only)
# For production AWS S3, see .env.production.example
USE_MINIO=True
MINIO_ENDPOINT=localhost:9002
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET_NAME=bharatbuild-storage

# Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Email (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@bharatbuild.ai

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Where GitHub/GitLab can reach this API to deliver repository push webhooks.
# Leave blank in production if NEXT_PUBLIC_API_URL is already public; set it to
# a tunnel (e.g. https://<id>.ngrok-free.app) to test webhooks locally.
WEBHOOK_PUBLIC_URL=

# Lets students link their GitHub account in one click instead of typing their
# username and commit email. Create an OAuth App at
# https://github.com/settings/developers with the Authorization callback URL
# set to GITHUB_REDIRECT_URI below, then paste its credentials here. Leaving
# these blank keeps the manual path working; only the one-click button and the
# GitHub button on the sign-in page are switched off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/auth/callback/github
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# File Upload
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,doc,docx,txt,png,jpg,jpeg

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- Contact verification (registration OTP) -------------------------------
# Email codes go out over the SMTP settings above. SMS needs one of these.
# With neither set, OTP requests fail outside development; in development the
# code is returned in the API response and clearly labelled as not-sent.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=BBUILD
MSG91_TEMPLATE_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_NUMBER=

# --- GitHub App: creating a batch's repository in its college's org ---
# Optional. Without these, a team connects a repository by hand and everything
# else works as before. Create a GitHub App, install it on each college's
# organisation, then record the org name and installation id against that
# college. The private key is a PEM - keep it out of git.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
