{
  "name": "@bharatbuild/cli",
  "version": "1.0.0",
  "description": "BharatBuild AI — CLI for AI-powered code generation, student projects, founder tools & more",
  "author": "BharatBuild AI <support@bharatbuild.ai>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bharatbuild": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "node --loader ts-node/esm src/index.ts",
    "watch": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "prepublish": "npm run clean && npm run build",
    "start": "node dist/index.js",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^5.3.0",
    "clipboardy": "^5.3.2",
    "commander": "^12.1.0",
    "conf": "^13.0.0",
    "eventsource-parser": "^2.0.0",
    "execa": "^9.3.0",
    "fast-glob": "^3.3.2",
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^13.0.3",
    "marked-terminal": "^7.3.0",
    "minimatch": "^10.2.6",
    "node-fetch": "^3.3.2",
    "openai": "^4.57.0",
    "ora": "^8.1.0",
    "p-retry": "^6.2.0",
    "prompts": "^2.4.2",
    "react": "^18.3.1",
    "semver": "^7.6.3",
    "shiki": "^4.4.3",
    "simple-git": "^3.26.0",
    "smol-toml": "^1.8.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.5.4",
    "@types/prompts": "^2.4.9",
    "@types/react": "^18.3.31",
    "@types/semver": "^7.5.8",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9.10.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "cli",
    "code-generation",
    "bharatbuild",
    "developer-tools",
    "india",
    "student",
    "founder",
    "college"
  ]
}
